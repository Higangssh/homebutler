# The surface homebutler freezes at 1.0.
# Regenerate with: go test ./internal/contract -update
# What this covers, and what it deliberately does not, is in docs/compatibility.md.

## tools
alerts risk=read args=[server:string]
alerts_history risk=read args=[server:string]
backup_create risk=write args=[exclude:array<string> server:string service:string to:string]
backup_drill risk=write args=[all:boolean app:string archive:string server:string]
backup_list risk=read args=[server:string]
backup_restore risk=destructive args=[archive:string server:string service:string] required=[archive]
config_validate risk=read args=[strict:boolean]
docker_inspect risk=read args=[name:string server:string] required=[name]
docker_list risk=read args=[server:string]
docker_logs risk=read args=[lines:integer name:string server:string] required=[name]
docker_restart risk=write args=[name:string server:string] required=[name]
docker_stats risk=read args=[server:string]
docker_stop risk=destructive args=[name:string server:string] required=[name]
docker_top risk=read args=[name:string server:string] required=[name]
doctor risk=read args=[backup_max_age_hours:integer server:string]
install_app risk=write args=[app:string port:integer] required=[app]
install_list risk=read args=[]
install_purge risk=destructive args=[app:string] required=[app]
install_status risk=read args=[app:string] required=[app]
install_uninstall risk=write args=[app:string] required=[app]
inventory_export risk=read args=[format:string server:string]
inventory_scan risk=read args=[server:string]
network_scan risk=read args=[]
notify_test risk=write args=[server:string]
open_ports risk=read args=[server:string]
processes risk=read args=[limit:integer server:string sort_by:string]
proxmox_guest_reboot risk=write args=[confirm:boolean endpoint:string node:string type:string{lxc|qemu} vmid:integer] required=[confirm endpoint node type vmid]
proxmox_guest_shutdown risk=destructive args=[confirm:boolean endpoint:string node:string type:string{lxc|qemu} vmid:integer] required=[confirm endpoint node type vmid]
proxmox_guest_start risk=write args=[confirm:boolean endpoint:string node:string type:string{lxc|qemu} vmid:integer] required=[confirm endpoint node type vmid]
proxmox_guests risk=read args=[endpoint:string node:string status:string type:string]
proxmox_node risk=read args=[endpoint:string node:string] required=[node]
proxmox_script_command risk=read args=[slug:string] required=[slug]
proxmox_script_list risk=read args=[]
proxmox_status risk=read args=[endpoint:string]
proxmox_task_status risk=read args=[endpoint:string node:string upid:string] required=[endpoint node upid]
proxmox_tasks risk=read args=[endpoint:string node:string] required=[node]
report risk=write args=[keep:integer no_save:boolean server:string]
system_status risk=read args=[server:string]
wake risk=write args=[broadcast:string target:string] required=[target]
watch_add risk=write args=[container:string kind:string{docker|pm2|systemd} server:string unit:string] required=[container]
watch_check risk=write args=[server:string]
watch_history risk=read args=[container:string include_logs:boolean limit:integer server:string]
watch_list risk=read args=[server:string]
watch_remove risk=write args=[container:string server:string] required=[container]

## routes
GET /api/alerts protection=none
GET /api/backup protection=none
GET /api/capabilities protection=none
GET /api/config protection=none
GET /api/docker protection=none
GET /api/docker/stats protection=none
GET /api/doctor protection=none
GET /api/install protection=none
GET /api/install/{app} protection=none
GET /api/overview protection=none
GET /api/ports protection=none
GET /api/processes protection=none
GET /api/proxmox/endpoints protection=none
GET /api/proxmox/guests protection=none
GET /api/proxmox/status protection=none
GET /api/report protection=none
GET /api/servers protection=none
GET /api/servers/{name}/status protection=none
GET /api/status protection=none
GET /api/version protection=none
GET /api/wake protection=none
GET /api/watch protection=none
GET /api/watch/incidents protection=none
GET /api/watch/incidents/{id} protection=none
OPTIONS /api/ protection=none
POST /api/backup protection=token
POST /api/backup/drill protection=token
POST /api/backup/restore protection=token+name
POST /api/docker/{name}/restart protection=token
POST /api/docker/{name}/stop protection=token+confirm
POST /api/install/{app} protection=token
POST /api/install/{app}/purge protection=token+name
POST /api/install/{app}/uninstall protection=token
POST /api/notify/test protection=token
POST /api/proxmox/guests/{vmid}/reboot protection=token
POST /api/proxmox/guests/{vmid}/shutdown protection=token+confirm
POST /api/proxmox/guests/{vmid}/start protection=token
POST /api/report/snapshot protection=token
POST /api/wake/{name} protection=token
POST /api/watch/check protection=token
POST /api/watch/targets protection=token
POST /api/watch/targets/{name}/remove protection=token
PUT /api/config/alerts protection=token
PUT /api/config/notify protection=token
PUT /api/config/proxmox protection=token
PUT /api/config/servers protection=token
PUT /api/config/wake protection=token

